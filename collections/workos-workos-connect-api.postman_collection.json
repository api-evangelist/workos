                  "raw": "{\n  \"external_auth_id\": \"ext_auth_01HXYZ123456789ABCDEFGHIJ\",\n  \"user\": {\n    \"id\": \"user_12345\",\n    \"email\": \"marcelina.davis@example.com\",\n    \"first_name\": \"Marcelina\",\n    \"last_name\": \"Davis\",\n    \"metadata\": {\n      \"department\": \"Engineering\",\n      \"role\": \"Developer\"\n    }\n  },\n  \"user_consent_options\": [\n    {\n      \"claim\": \"tos_accepted\",\n      \"type\": \"string\",\n      \"label\": \"Terms of Service\",\n      \"choices\": [\n        {\n          \"value\": \"accepted\",\n          \"label\": \"I accept the Terms of Service\"\n        }\n      ]\n    },\n    {\n      \"claim\": \"tos_accepted\",\n      \"type\": \"string\",\n      \"label\": \"Terms of Service\",\n      \"choices\": [\n        {\n          \"value\": \"accepted\",\n          \"label\": \"I accept the Terms of Service\"\n        }\n      ]\n    }\n  ]\n}",
