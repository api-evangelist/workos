{
  "opencollection": "1.0.0",
  "info": {
    "name": "WorkOS admin-portal widgets API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "widgets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Generate a Widget Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.workos.com/widgets/token",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generate a widget token scoped to an organization and user with the specified scopes."
        }
      ]
    }
  ],
  "bundled": true
}